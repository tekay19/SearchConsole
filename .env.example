# Bu dosyayı .env.local olarak kopyalayıp değerleri doldurun.
# Doğrulama şeması: src/server/env.ts

# docker compose up -d ile ayağa kalkan yerel Postgres
DATABASE_URL=postgres://sp:sp@localhost:5432/search_performance

# docker compose up -d ile ayağa kalkan yerel Redis
REDIS_URL=redis://localhost:6379

# Auth.js oturum imzalama anahtarı (en az 32 karakter)
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Google Cloud Console > Kimlik Bilgileri > OAuth istemci kimliği (Web uygulaması)
# Yetkili yönlendirme adresi: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Veritabanına yazılan gizli değerleri şifreler. Tam 32 bayt, base64 kodlu.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Bu anahtar kaybolursa kayıtlı Google bağlantıları çözülemez ve kullanıcılar yeniden bağlanmak zorunda kalır.
APP_ENCRYPTION_KEY=
